{
  "parser": {
    ".vue$": "@markuplint/vue-parser"
  },
  "extends": [
    "markuplint:recommended"
  ],
  "rules": {
    // @markuplint/vue-parser（v4.18系）は `:key`（`v-bind:key`）と `ref` を
    // ディレクティブではなく素の HTML 属性 `key` / `ref` として解決するため、
    // 標準 HTML には存在しない属性として誤検知される。
    // Vue SFC ではあらゆる要素に付与しうるため、この2属性のみ全体で許可する。
    // パーサー側の制限に対する暫定処置であり、解消されたら削除すること。
    "invalid-attr": {
      "options": {
        "allowAttrs": ["key", "ref"]
      }
    }
  },
  "nodeRules": [
    {
      // @markuplint/vue-parser（v4.18系）は `@keyup.enter` と `@keyup.space` の
      // ような「同じイベント種別 + 異なるキー修飾子」を持つ v-on 属性を、
      // 修飾子を無視した `onkeyup` という同一の potentialName に解決してしまい、
      // attr-duplication が誤検知する（`@keydown.space.prevent` のように
      // 修飾子が2つ以上あると正規表現がマッチせず誤検知しない、という
      // アンバランスなパーサー側の既知の制限に起因する）。
      // .poem-card は Collection.vue のカード要素にのみ使用するクラスのため、
      // 影響範囲をこの要素に限定して誤検知のみを抑止する。
      // .badge-card (Badges.vue) にも同じ問題があるため追加する。
      "selector": ".poem-card, .badge-card",
      "rules": {
        "attr-duplication": false
      }
    },
    {
      // 正解／不正解の効果音のみを再生する <audio> で、発話情報を含まないため
      // キャプション（<track>）は不要。同じ理由で ESLint の
      // vuejs-accessibility/media-has-caption も個別に無効化している。
      "selector": "audio",
      "rules": {
        "required-element": false
      }
    }
  ]
}
