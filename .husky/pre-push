#!/bin/sh

# ローカルでの --no-verify コミット等によるシークレットの流出を防ぐため、
# push 前に「実際に送信されるコミット」をシークレットスキャンします。
# 作業ツリーやステージ済み差分ではなく、Git が標準入力で渡す参照から
# プッシュ対象のコミット範囲を求めて検査します。
echo "🔒 pre-pushフックを実行中... シークレットの流出を防ぎます。"

remote_name="$1"
zero_sha="0000000000000000000000000000000000000000"

if ! command -v gitleaks > /dev/null 2>&1; then
  echo "⚠️ gitleaksがローカルにインストールされていません。プッシュ対象コミットの検査をスキップします。"
  exit 0
fi

# 標準入力の各行: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # ブランチ削除のプッシュは検査対象のコミットが無い
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    # 新規ブランチ: リモートに存在しないコミットだけを検査する
    log_opts="$local_sha --not --remotes=$remote_name"
  elif git cat-file -e "${remote_sha}^{commit}" 2> /dev/null; then
    log_opts="$remote_sha..$local_sha"
  else
    # リモート側 SHA がローカルに無い場合（未 fetch の他者の push など）は範囲を解決できず、
    # gitleaks が 0 コミット検査で成功扱いになるため、新規ブランチと同じ方式に切り替える
    log_opts="$local_sha --not --remotes=$remote_name"
  fi

  echo "🔒 プッシュ対象コミットを gitleaks で検査中... ($log_opts)"
  # log_opts は意図的に単語分割せず、1 つの引数として渡す
  gitleaks git --verbose --redact --log-opts="$log_opts" || exit 1
done

echo "✅ pre-push チェック完了。push を続行します。"
