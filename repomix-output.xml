161: <script>
162: import { mapGetters } from 'vuex'
163: import poems from '@/data/poems'
164: // フィルター種類の定数
165: const FILTERS = {
166:   ALL: 'all',
167:   COLLECTED: 'collected',
168:   UNCOLLECTED: 'uncollected',
169: }
170: export default {
171:   name: 'Collection',
172:   data () {
173:     return {
174:       poems,
175:       filter: FILTERS.ALL,
176:       showModal: false,
177:       selectedPoem: null,
178:     }
179:   },
180:   computed: {
181:     ...mapGetters('collection', ['collectedCount', 'isCollected']),
182:     totalCount () {
183:       return this.poems.length
184:     },
185:     collectionRate () {
186:       if (this.totalCount === 0) return 0
187:       return Math.round((this.collectedCount / this.totalCount) * 100)
188:     },
189:     filteredPoems () {
190:       if (this.filter === FILTERS.COLLECTED) {
191:         return this.poems.filter((p) => this.isCollected(p.id))
192:       } else if (this.filter === FILTERS.UNCOLLECTED) {
193:         return this.poems.filter((p) => !this.isCollected(p.id))
194:       }
195:       return this.poems
196:     },
197:   },
