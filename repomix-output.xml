<file path=".github/workflows/dependabot-auto-merge.yml">
 1: name: Dependabot auto-merge
 2: on: pull_request
 3: concurrency:
 4:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
 5:   cancel-in-progress: true
 6: permissions: {}
 7: jobs:
 8:   dependabot:
 9:     runs-on: ubuntu-latest
10:     permissions:
11:       contents: write # gh pr merge でのマージ実行に必要
12:       pull-requests: write # gh pr merge --auto でのオートマージ予約に必要
13:     if: github.event.pull_request.user.login == 'dependabot[bot]'
14:     steps:
15:       - name: Harden Runner
16:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
17:         with:
18:           egress-policy: audit
19:       - name: Dependabot metadata
20:         id: metadata
21:         uses: dependabot/fetch-metadata@25dd0e34f4fe68f24cc83900b1fe3fe149efef98 # v3.1.0
22:         with:
23:           github-token: '${{ secrets.GITHUB_TOKEN }}'
24:       # GITHUB_TOKEN では自リポジトリの PR を approve できないため、
25:       # approve はメンテナーの手動レビューに委ね、auto-merge のみを仕掛ける。
26:       - name: Enable auto-merge for Dependabot PRs
27:         if: steps.metadata.outputs.update-type != 'version-update:semver-major'
28:         run: |
29:           gh pr merge --auto --squash "$PR_URL"
30:         env:
31:           PR_URL: ${{github.event.pull_request.html_url}}
32:           GH_TOKEN: ${{secrets.GITHUB_TOKEN}}
</file>

<file path=".github/workflows/dependency-review.yml">
 1: name: Dependency Review
 2: on:
 3:   pull_request:
