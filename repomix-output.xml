 75:       return ((this.score / 100) * 100).toFixed(1)
 76:     }
 77:   },
 78:   mounted () {
 79:     this.timeMs = parseInt(this.$route.params.timeMs)
 80:     this.score = parseInt(this.$route.params.score)
 81:   },
 82:   methods: {
 83:     formatTimeMs (ms) {
 84:       const seconds = Math.floor(ms / 1000)
 85:       const minutes = Math.floor(seconds / 60)
 86:       const remainingSeconds = seconds % 60
 87:       const milliseconds = Math.floor((ms % 1000) / 10)
 88:       return `${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}.${milliseconds.toString().padStart(2, '0')}`
 89:     }
 90:   }
 91: }
