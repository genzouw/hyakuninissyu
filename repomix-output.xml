<file path=".github/workflows/repomix.yml">
 1: name: Repomix
 2: on:
 3:   push:
 4:     branches:
 5:       - main
 6:   pull_request:
 7:     branches:
 8:       - main
 9:   schedule:
10:     - cron: '0 0 * * 0' # 毎週日曜日に実行
11: permissions:
12:   contents: read
13: concurrency:
14:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
15:   cancel-in-progress: true
16: jobs:
17:   pack-repo:
18:     name: Pack repository with Repomix
19:     runs-on: ubuntu-latest
20:     permissions:
21:       contents: write # ai-context ブランチへのプッシュに必要
22:     steps:
23:       - name: Harden Runner
24:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
25:         with:
26:           egress-policy: audit
27:       - name: Checkout repository
28:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
29:         with:
30:           persist-credentials: false
31:       - name: Setup Bun Environment
32:         uses: ./.github/actions/setup-bun-env
33:       - name: Build and generate llms-full.txt
34:         env:
35:           NODE_OPTIONS: --openssl-legacy-provider
36:         run: bun run build
37:       # yamadashy/repomix の Action はリポジトリの Actions allow list 外のため、
38:       # devDependency としてインストール済みの repomix CLI を直接実行する。
39:       - name: Pack repository with Repomix
40:         run: bun run repomix --output repomix-output.xml --style xml
41:       - name: Upload Repomix output
42:         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
43:         with:
44:           name: repomix-output
45:           path: repomix-output.xml
46:       - name: Prepare ai-context directory
47:         run: |
48:           mkdir -p public-context
49:           cp repomix-output.xml public-context/
50:           # AIクローラーや検索エンジン(GEO)向けによりリッチなコンテキストを公開
51:           if [ -f "dist/llms-full.txt" ]; then
52:             cp dist/llms-full.txt public-context/
53:           fi
54:           # static/llms.txt も合わせて配置
55:           if [ -f "static/llms.txt" ]; then
56:             cp static/llms.txt public-context/
57:           fi
58:       # peaceiris/actions-gh-pages はリポジトリの Actions allow list 外のため、
59:       # git による orphan ブランチへの強制 push に置換している (force_orphan 相当)。
60:       - name: Deploy to ai-context branch
61:         if: github.event_name != 'pull_request'
62:         env:
63:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
64:         run: |
65:           set -euo pipefail
66:           cd public-context
67:           git init -q
68:           git checkout -q --orphan ai-context
69:           git config user.name 'github-actions[bot]'
70:           git config user.email 'github-actions[bot]@users.noreply.github.com'
71:           git add -A
72:           if git diff --cached --quiet; then
73:             echo "No changes to deploy; skipping commit/push."
74:             exit 0
75:           fi
76:           git commit -q -m 'chore: update repomix and AI context output [skip ci]'
77:           git push -q --force \
78:             "https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" \
79:             ai-context:ai-context
</file>

<file path=".github/workflows/reviewdog.yml">
  1: name: reviewdog (自動コードレビュー)
  2: on:
  3:   pull_request:
  4:     types: [opened, synchronize, reopened]
  5: permissions:
  6:   contents: read
  7: concurrency:
  8:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  9:   cancel-in-progress: true
 10: jobs:
 11:   eslint:
 12:     name: ESLint による自動コードレビュー
 13:     runs-on: ubuntu-latest
 14:     timeout-minutes: 10
 15:     permissions:
 16:       contents: read
 17:       pull-requests: write
 18:       checks: write
 19:     steps:
 20:       - name: Harden Runner
 21:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
 22:         with:
 23:           egress-policy: audit
 24:       - name: リポジトリのチェックアウト
 25:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
 26:         with:
 27:           persist-credentials: false
 28:       - name: Setup Bun Environment
 29:         uses: ./.github/actions/setup-bun-env
 30:       - name: Setup reviewdog
 31:         uses: reviewdog/action-setup@d8a7baabd7f3e8544ee4dbde3ee41d0011c3a93f # v1.5.0
 32:         with:
 33:           reviewdog_version: v0.21.0
 34:       - name: Run ESLint with Reviewdog
 35:         env:
 36:           REVIEWDOG_GITHUB_API_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 37:         shell: bash
 38:         run: |
 39:           set -o pipefail
 40:           bun x eslint -f stylish "src/" "test/" \
 41:             | reviewdog -f=eslint -name="eslint" -reporter=github-pr-review -fail-level=any
 42:   stylelint:
 43:     name: Stylelint による自動コードレビュー
 44:     runs-on: ubuntu-latest
 45:     timeout-minutes: 10
 46:     permissions:
 47:       contents: read
 48:       pull-requests: write
 49:     steps:
 50:       - name: Harden Runner
 51:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
 52:         with:
 53:           egress-policy: audit
 54:       - name: リポジトリのチェックアウト
 55:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
 56:         with:
 57:           persist-credentials: false
 58:       - name: Setup Bun Environment
 59:         uses: ./.github/actions/setup-bun-env
 60:       - name: Setup reviewdog
 61:         uses: reviewdog/action-setup@d8a7baabd7f3e8544ee4dbde3ee41d0011c3a93f # v1.5.0
 62:         with:
 63:           reviewdog_version: v0.21.0
 64:       - name: Run Stylelint with Reviewdog
 65:         env:
 66:           REVIEWDOG_GITHUB_API_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 67:         shell: bash
 68:         run: |
 69:           set -o pipefail
 70:           bun x stylelint "src/**/*.vue" \
 71:             | reviewdog -f=stylelint -name="stylelint" -reporter=github-pr-review -fail-level=any
 72:   textlint:
 73:     name: Textlint による自動コードレビュー
 74:     runs-on: ubuntu-latest
 75:     timeout-minutes: 10
 76:     permissions:
 77:       contents: read
 78:       pull-requests: write
 79:     steps:
 80:       - name: Harden Runner
 81:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
 82:         with:
 83:           egress-policy: audit
 84:       - name: リポジトリのチェックアウト
 85:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
 86:         with:
 87:           persist-credentials: false
 88:       - name: Setup Bun Environment
 89:         uses: ./.github/actions/setup-bun-env
 90:       - name: Setup reviewdog
 91:         uses: reviewdog/action-setup@d8a7baabd7f3e8544ee4dbde3ee41d0011c3a93f # v1.5.0
 92:         with:
 93:           reviewdog_version: v0.21.0
 94:       - name: Run Textlint with Reviewdog
 95:         env:
 96:           REVIEWDOG_GITHUB_API_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 97:         shell: bash
 98:         run: |
 99:           set -o pipefail
100:           bun x textlint -f checkstyle "**/*.md" \
101:             | reviewdog -f=checkstyle -name="textlint" -reporter=github-pr-review -fail-on-error || true
102:   markuplint:
103:     name: Markuplint による自動コードレビュー
104:     runs-on: ubuntu-latest
105:     timeout-minutes: 10
106:     permissions:
107:       contents: read
108:       pull-requests: write
109:     steps:
110:       - name: Harden Runner
111:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
112:         with:
113:           egress-policy: audit
114:       - name: リポジトリのチェックアウト
115:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
116:         with:
117:           persist-credentials: false
118:       - name: Setup Bun Environment
119:         uses: ./.github/actions/setup-bun-env
120:       - name: Setup reviewdog
121:         uses: reviewdog/action-setup@d8a7baabd7f3e8544ee4dbde3ee41d0011c3a93f # v1.5.0
122:         with:
123:           reviewdog_version: v0.21.0
124:       - name: Run Markuplint with Reviewdog
125:         env:
126:           REVIEWDOG_GITHUB_API_TOKEN: ${{ secrets.GITHUB_TOKEN }}
127:         shell: bash
128:         run: |
129:           set -euo pipefail
130:           markuplint_json="$(mktemp)"
131:           # markuplint は違反を検出すると非ゼロ終了しうる。pipefail でジョブ全体が
132:           # 失敗しないよう、出力を一時ファイルへ退避して終了コードを切り離す。
133:           markuplint_exit=0
134:           bun x markuplint -f JSON "src/**/*.vue" > "${markuplint_json}" || markuplint_exit=$?
135:           # JSON として妥当でない場合は markuplint 自体の実行エラーとみなし、ジョブへ伝播させる。
136:           if ! jq -e 'type == "array"' "${markuplint_json}" > /dev/null 2>&1; then
137:             echo "::error::markuplint の JSON 出力が不正です (exit code: ${markuplint_exit})"
138:             cat "${markuplint_json}"
139:             exit 1
140:           fi
141:           # markuplint の filePath は絶対パスのため、reviewdog が PR の差分と突き合わせられるよう
142:           # リポジトリルートからの相対パスへ変換する。
143:           # reviewdog の実行エラー・API エラーはそのままジョブへ伝播させる。
144:           jq -r --arg root "${GITHUB_WORKSPACE}/" \
145:             '.[] | "\(.filePath | ltrimstr($root)):\(.line):\(.col): \(.message) (\(.ruleId))"' \
146:             "${markuplint_json}" \
147:             | reviewdog -efm="%f:%l:%c: %m" -name="markuplint" -reporter=github-pr-review -fail-level=none
</file>

