13:   workflow_dispatch:
14: concurrency:
15:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
16:   cancel-in-progress: true
17: permissions:
18:   contents: read
19: jobs:
20:   trufflehog:
21:     permissions:
22:       contents: read
23:     name: Comprehensive Secret Verification
24:     runs-on: ubuntu-latest
25:     steps:
26:       - name: Harden Runner
27:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
28:         with:
29:           egress-policy: audit
30:       - name: Checkout repository
31:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
32:         with:
33:           fetch-depth: 0
34:           persist-credentials: false
35:       - name: Run TruffleHog (All Secrets, Push/PR)
36:         if: github.event_name == 'push' || github.event_name == 'pull_request'
37:         uses: trufflesecurity/trufflehog@363923b901c911a9164f50b6c423f47c15372b1c # v3.97.4
38:         # NOTE: このコミットSHA固定はアクション本体（ワークフロー実行ロジック）のみを対象と
39:         # する。version 入力を省略しているため、実際にスキャンを行う Docker イメージ
40:         # （ghcr.io/trufflesecurity/trufflehog）は latest タグのまま運用しており、
41:         # スキャナ本体のバージョンはアクションのSHA固定とは独立している。これは、
42:         # シークレット検出パターンの鮮度を優先するための意図的な選択である
43:         # （Dependabot の docker エコシステムは /web のみを対象としており、この
44:         # イメージタグの更新は追従しない）。
45:         # NOTE: --no-update はアクション側がデフォルトで付与するため extra_args では指定しない
46:         # --only-verified は削除し、未検証・無効化済みのシークレットも含めて全てブロックするよう厳格化
47:         # base, head を省略した場合、アクション側で push は before→after、PR は base.sha→head.sha
48:         # の差分レンジが自動設定され、過去コミットの検知は保証されない。
49:         # そのため base: '' を明示しつつ head にコミットSHAを指定し、
50:         # push / PR いずれのイベントでもリポジトリ全履歴をスキャンするようにする
51:         # （公式ドキュメントの "Advanced Usage: Scan entire branch" 相当の構成）
52:         #
53:         # exclude-detectors=GoogleGeminiAPIKey について: 除外理由（コミット 57d12b2 の
54:         # コミットメッセージ由来の誤検知）・影響範囲・代替検査手段（gitleaks / GitHub
55:         # Secret Scanning）・PR実行時の補完ステップとの関係は、二重管理を避けるため
56:         # docs/security/leak-prevention.md の「2. CI 検知」に一元化している。
57:         # 詳細はそちらを参照すること（本コメントでは繰り返さない）。
58:         with:
59:           base: ''
60:           head: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}
61:           extra_args: --exclude-detectors=GoogleGeminiAPIKey
62:       # schedule/workflow_dispatch では base/head を渡さない。head に単一のコミット SHA を
63:       # 渡すと、アクション側は常に「BASE/HEAD 明示パス」に入り、その ref のみを走査対象と
64:       # した単一ブランチの走査に縮退してしまう（実行ログの chunks/bytes 比較で確認済み。
65:       # schedule 実行時のほうが常に走査量が多かった）。base/head を両方とも省略/空にした
66:       # 場合のみ、アクション側は schedule/workflow_dispatch 用のフォールバック（base/head
67:       # を空文字列のまま docker 実行に渡す）を使うため、このステップは分離し、
68:       # with: に base/head を一切指定しない。
69:       #
70:       # NOTE: GitHub Actions の三項演算子的な書き方
71:       # `github.event_name == 'schedule' && '' || <fallback>` は使わない。GitHub Actions の
72:       # 式では空文字列 '' は falsy として扱われるため、&& の結果である '' が || の左辺に来ると
73:       # 常に <fallback> 側へ流れてしまい、意図通りに空文字列を返せない（このステップを分離
74:       # した理由そのもの）。
75:       - name: Run TruffleHog (All Secrets, Schedule/Dispatch)
76:         if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
77:         uses: trufflesecurity/trufflehog@363923b901c911a9164f50b6c423f47c15372b1c # v3.97.4
78:         with:
79:           extra_args: --exclude-detectors=GoogleGeminiAPIKey
80:       # 上記ステップは GoogleGeminiAPIKey 検出器を除外している。この除外は誤検知の原因と
81:       # なった過去コミットだけでなく、これから積まれる新規コミットにも一律に適用されるため、
82:       # PR で新たに混入した AIzaSy... 形式のシークレットの検知力が純減してしまう。
83:       # そのため PR 実行時のみ、差分レンジ（PR の base〜head）を全検出器（除外なし）で
84:       # 再スキャンする。誤検知の原因コミット 57d12b2 は通常の PR の base より前に存在する
85:       # ため、この補完ステップで再び誤検知することはない。
86:       - name: Run TruffleHog (PR diff, all detectors)
87:         if: github.event_name == 'pull_request'
88:         uses: trufflesecurity/trufflehog@363923b901c911a9164f50b6c423f47c15372b1c # v3.97.4
89:         with:
90:           base: ${{ github.event.pull_request.base.sha }}
91:           head: ${{ github.event.pull_request.head.sha }}
</file>

