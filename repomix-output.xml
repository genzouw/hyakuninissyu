 1: [extend]
 2: useDefault = true
 3: 
 4: [[rules]]
 5: id = "pii-email"
 6: description = "個人を特定できる情報 (PII) - メールアドレスを検知する"
 7: # 正規表現でメールアドレスを検知（ドメイン部に最低1文字のアルファベットを要求し、
 8: # Bun のパッチファイル名（例: 29.2.6.patch）等の数値のみドメインを誤検知しないようにする）
 9: # 検知範囲の仕様（数値のみドメイン・非 ASCII ドメイン・1文字 TLD を検知しないこと）は
10: # docs/security/leak-prevention.md に明記し、scripts/test_gitleaks_pii_email.py で
11: # 回帰テストとして固定している。本ルールと下の許可リストを変更する際は両方を更新すること。
12: regex = '''(?i)([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]*[A-Za-z][A-Za-z0-9.-]*\.[A-Za-z]{2,})'''
13: secretGroup = 1
14: entropy = 0.0
15: 
16: [[rules.allowlists]]
17: description = "公開済みメールアドレスやダミーデータ、CI で使用する GitHub Actions bot のメールアドレスを pii-email ルールに限定して除外する（トップレベルの [allowlist] にすると全ルールに適用され、通常の GitHub ユーザーアドレスまで検知対象外になってしまうため）。"
18: # gitleaks の allowlist regexes は未アンカーだと検知対象（secretGroup で切り出した文字列）に対する
19: # 部分一致となり、`xgenzouw@gmail.com` や `alice+genzouw@gmail.com` のような別アドレスまで
20: # 除外されてしまう。誤って除外しないよう、各パターンは必ず `^` と `$` で完全一致に固定する。
21: regexes = [
22:   '''(?i)^genzouw@gmail\.com$''',
23:   '''(?i)^dummy@example\.com$''',
24:   '''(?i)^test@example\.com$''',
25:   '''(?i)^github-actions\[bot\]@users\.noreply\.github\.com$''',
26:   '''(?i)^dependabot\[bot\]@users\.noreply\.github\.com$''',
27:   # docs/security/leak-prevention.md の過去コミット（eddaccac）で bun パッチファイル名の誤検知例として
28:   # 記載した文字列。実在のメールアドレスではなくドキュメント上の例示であり、git 履歴に残り続けるため許可リスト化。
29:   # `patches/@scope%2Fpkg@version.patch` からは、走査の起点により
30:   # `scope%2Fpkg@version.patch` / `pkg@version.patch` のいずれの部分文字列も切り出されうるため両方を許可する。
31:   '''(?i)^scope%2Fpkg@version\.patch$''',
32:   '''(?i)^pkg@version\.patch$''',
33:   # このファイル自身（.gitleaks.toml）が、上記コメントで「誤って許可リスト化されてしまう例」として
34:   # 挙げている `xgenzouw@gmail.com` / `alice+genzouw@gmail.com` という文字列を含んでいる。
35:   # `ai-context` ブランチ（Repomix ワークフローが生成する repomix-output.xml / llms-full.txt の
36:   # スナップショット）にはリポジトリ全体のテキストがそのまま収録されるため、このコメント文字列も
37:   # 一緒に取り込まれてしまう。gitleaks は `--log-opts="--all"` で全ブランチの履歴を走査するため、
38:   # 実在しないダミーアドレスであるにもかかわらず pii-email として検知され続ける。実データではない
39:   # ドキュメント上の例示であるため許可リスト化する。
40:   '''(?i)^xgenzouw@gmail\.com$''',
41:   '''(?i)^alice\+genzouw@gmail\.com$'''
42: ]
43: 
