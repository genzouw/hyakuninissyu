42:       - name: SARIF ファイルのアップロード
43:         uses: github/codeql-action/upload-sarif@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4.37.9
44:         if: always() && hashFiles('osv-scanner-results.sarif') != ''
45:         with:
46:           sarif_file: osv-scanner-results.sarif
47:           category: osv-scanner
</file>

<file path=".github/workflows/pr_conflict_notify.yml">
  1: name: PR Conflict Notification
  2: on:
  3:   # main ブランチへの push 時に全 PR をチェック
  4:   push:
  5:     branches:
  6:       - main
  7:   # 定期実行 (毎日 09:00 JST = 00:00 UTC)
  8:   schedule:
  9:     - cron: '0 0 * * *'
 10:   workflow_dispatch:
 11: concurrency:
 12:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
 13:   # このワークフローは push(main) / schedule / workflow_dispatch のみが起点で
 14:   # PR コンテキストを持たないため concurrency group は実質固定される。
 15:   # cancel-in-progress: true にすると schedule 実行中の通知処理が
 16:   # push によってキャンセルされ、コンフリクト通知を取りこぼす可能性があるため false を維持する。
 17:   cancel-in-progress: false
 18: permissions:
 19:   contents: read
 20: jobs:
 21:   check-conflicts:
 22:     runs-on: ubuntu-latest
 23:     permissions:
 24:       contents: read
 25:       pull-requests: read
 26:       issues: write
 27:     steps:
 28:       - name: Harden Runner
 29:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
 30:         with:
 31:           egress-policy: audit
 32:       - name: Check PR conflicts and notify authors
 33:         uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
 34:         with:
 35:           github-token: ${{ secrets.GITHUB_TOKEN }}
 36:           script: |
 37:             const owner = context.repo.owner;
 38:             const repo = context.repo.repo;
 39:             console.log(`🔍 Checking for conflicting PRs in ${owner}/${repo}...`);
 40:             const pullRequests = await github.paginate(github.rest.pulls.list, {
 41:               owner,
 42:               repo,
 43:               state: 'open',
 44:               per_page: 100,
 45:             });
 46:             console.log(`📋 Found ${pullRequests.length} open PRs`);
 47:             if (pullRequests.length === 0) {
 48:               console.log('✅ No open PRs found');
 49:               return;
 50:             }
 51:             const conflictedPRs = [];
 52:             const mergeableByPrNumber = new Map();
 53:             for (const pr of pullRequests) {
 54:               console.log(`\n🔎 Checking PR #${pr.number}: ${pr.title}`);
 55:               const { data: prDetail } = await github.rest.pulls.get({
 56:                 owner,
 57:                 repo,
 58:                 pull_number: pr.number,
 59:               });
 60:               // mergeable が null の場合は計算中なのでリトライ
 61:               let mergeable = prDetail.mergeable;
 62:               const maxRetries = 3;
 63:               const retryDelays = [3000, 5000, 10000];
 64:               for (let retry = 0; retry < maxRetries && mergeable === null; retry++) {
 65:                 console.log(`⏳ Mergeable status is being calculated for PR #${pr.number}, waiting... (retry ${retry + 1}/${maxRetries})`);
 66:                 await new Promise(resolve => setTimeout(resolve, retryDelays[retry]));
 67:                 const { data: prDetailRetry } = await github.rest.pulls.get({
 68:                   owner,
 69:                   repo,
 70:                   pull_number: pr.number,
 71:                 });
 72:                 mergeable = prDetailRetry.mergeable;
 73:               }
 74:               mergeableByPrNumber.set(pr.number, mergeable);
 75:               if (mergeable === null) {
 76:                 console.log(`⚠️ WARNING: Mergeable status is still null for PR #${pr.number} after ${maxRetries} retries. Manual check may be required.`);
 77:                 continue;
 78:               }
 79:               console.log(`  - Mergeable: ${mergeable}`);
 80:               console.log(`  - Mergeable State: ${prDetail.mergeable_state}`);
 81:               console.log(`  - Author: @${pr.user.login}`);
 82:               if (mergeable === false) {
 83:                 conflictedPRs.push({
 84:                   number: pr.number,
 85:                   title: pr.title,
 86:                   author: pr.user.login,
 87:                   url: pr.html_url,
 88:                 });
 89:               }
 90:             }
 91:             console.log(`\n📊 Summary: ${conflictedPRs.length} PR(s) with conflicts`);
 92:             // コンフリクトが解消された PR の古いコメントを削除
 93:             // mergeable === true が確認できた PR のみを対象にする（null の PR は除外）
 94:             console.log('\n🧹 Checking for resolved conflicts...');
 95:             const nonConflictedPRNumbers = pullRequests
 96:               .filter(pr => mergeableByPrNumber.get(pr.number) === true)
 97:               .map(pr => pr.number);
 98:             const botCommentMarker = '<!-- pr-conflict-notify -->';
 99:             for (const prNumber of nonConflictedPRNumbers) {
100:               const comments = await github.paginate(github.rest.issues.listComments, {
101:                 owner,
102:                 repo,
103:                 issue_number: prNumber,
104:                 per_page: 100,
105:               });
106:               const existingComment = comments.find(
107:                 comment => comment.body && comment.body.includes(botCommentMarker)
108:               );
109:               if (existingComment) {
110:                 console.log(`  Deleting resolved conflict comment from PR #${prNumber}`);
111:                 try {
112:                   await github.rest.issues.deleteComment({
113:                     owner,
114:                     repo,
115:                     comment_id: existingComment.id,
116:                   });
117:                   console.log(`  ✅ Comment deleted from PR #${prNumber}`);
118:                 } catch (error) {
119:                   if (error.status === 404) {
120:                     console.log(`  ⚠️ Comment #${existingComment.id} was already deleted`);
121:                   } else {
122:                     throw error;
123:                   }
124:                 }
125:               }
126:             }
127:             if (conflictedPRs.length === 0) {
128:               console.log('✅ No conflicting PRs found');
129:               return;
130:             }
131:             for (const pr of conflictedPRs) {
132:               console.log(`\n💬 Posting comment to PR #${pr.number}...`);
133:               const comments = await github.paginate(github.rest.issues.listComments, {
134:                 owner,
135:                 repo,
136:                 issue_number: pr.number,
137:                 per_page: 100,
138:               });
139:               const existingComment = comments.find(
140:                 comment => comment.body && comment.body.includes(botCommentMarker)
141:               );
142:               const commentBody = `${botCommentMarker}
143:             ## ⚠️ コンフリクトが発生しています
144:             @${pr.author} さん
145:             このプルリクエストは \`main\` ブランチとコンフリクトが発生しています。
146:             マージする前にコンフリクトを解消してください。
147:             ### 解消方法
148:             \`\`\`bash
149:             # ローカルで main ブランチを最新化
150:             git checkout main
151:             git pull origin main
152:             # 作業ブランチに戻って main をマージ
153:             git checkout <your-branch>
154:             git merge main
155:             # コンフリクトを解消してコミット
156:             git add .
157:             git commit -m "fix: 🐛 main ブランチとのコンフリクトを解消"
158:             git push
159:             \`\`\`
160:             ---
161:             *このコメントは自動的に投稿されました。コンフリクトが解消されると、次回のチェック時にこのコメントは削除されます。*
162:             `;
163:               if (existingComment) {
164:                 console.log(`  Updating existing comment #${existingComment.id}`);
165:                 try {
166:                   await github.rest.issues.updateComment({
167:                     owner,
168:                     repo,
169:                     comment_id: existingComment.id,
170:                     body: commentBody,
171:                   });
172:                 } catch (error) {
173:                   if (error.status === 404) {
174:                     console.log(`  ⚠️ Comment #${existingComment.id} was already deleted, creating new comment instead`);
175:                     await github.rest.issues.createComment({
176:                       owner,
177:                       repo,
178:                       issue_number: pr.number,
179:                       body: commentBody,
180:                     });
181:                   } else {
182:                     throw error;
183:                   }
184:                 }
185:               } else {
186:                 console.log(`  Creating new comment`);
187:                 await github.rest.issues.createComment({
188:                   owner,
189:                   repo,
190:                   issue_number: pr.number,
191:                   body: commentBody,
192:                 });
193:               }
194:               console.log(`  ✅ Comment posted to PR #${pr.number}`);
195:             }
196:             console.log('\n🎉 PR conflict check completed!');
</file>

<file path=".github/workflows/pre-commit.yml">
 1: name: pre-commit
 2: on:
 3:   # push は既定ブランチのみ。'**' にすると、オープンなPRがあるブランチへの push で
 4:   # push と pull_request が同時発火し、同一コミットに対して二重実行される（#447）。
 5:   # PR の検証は pull_request 側が担う。
 6:   push:
 7:     branches: [main, master]
 8:   pull_request:
 9:     branches: ['**']
10:   schedule:
11:     # 毎週月曜 06:45 JST (= 日曜 21:45 UTC) に定期実行
12:     - cron: '45 21 * * 0'
13:   workflow_dispatch:
14: concurrency:
15:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
16:   cancel-in-progress: true
17: permissions:
18:   contents: read
19: jobs:
20:   pre-commit:
21:     permissions:
22:       contents: read
23:     name: Run pre-commit
24:     runs-on: ubuntu-latest
25:     steps:
26:       - name: Harden Runner
27:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
28:         with:
29:           egress-policy: audit
30:       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
31:         with:
32:           persist-credentials: false
33:       - name: Setup Python
34:         uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
35:         with:
36:           python-version: '3.10'
37:           cache: 'pip'
38:       - name: Cache pre-commit environments
39:         uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
40:         with:
41:           path: ~/.cache/pre-commit
42:           key: ${{ runner.os }}-pre-commit-${{ hashFiles('.pre-commit-config.yaml') }}
43:           restore-keys: |
44:             ${{ runner.os }}-pre-commit-
45:       - name: Install pre-commit
46:         run: pip install -r requirements.txt
47:       # scripts/test_gitleaks_pii_email.py は gitleaks 本体を実行して .gitleaks.toml の
48:       # 挙動を検証する。pre-commit が golang フックとして導入する gitleaks は
49:       # ~/.cache/pre-commit 配下に入り PATH に載らないため、テスト用に別途導入する。
50:       # バージョンは .pre-commit-config.yaml の `# frozen:` を単一ソースとして解決し、
51:       # Dependabot (pre-commit ecosystem) の rev 更新に自動追従させる。
52:       - name: Resolve pinned gitleaks version
53:         id: gitleaks
54:         run: |
55:           version=$(python -c "import sys; sys.path.insert(0, 'scripts'); import test_gitleaks_pii_email as t; print(t.frozen_gitleaks_version())")
56:           echo "version=${version}" >>"$GITHUB_OUTPUT"
57:       - name: Cache gitleaks binary
58:         uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
59:         with:
60:           path: ~/.local/bin/gitleaks
61:           key: ${{ runner.os }}-gitleaks-${{ steps.gitleaks.outputs.version }}
62:       - name: Install gitleaks
63:         env:
64:           GITLEAKS_VERSION: ${{ steps.gitleaks.outputs.version }}
65:         run: |
66:           set -euo pipefail
67:           mkdir -p "$HOME/.local/bin"
68:           echo "$HOME/.local/bin" >>"$GITHUB_PATH"
69:           if [ -x "$HOME/.local/bin/gitleaks" ]; then exit 0; fi
70:           base="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}"
71:           asset="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
72:           tmp=$(mktemp -d)
73:           curl -fsSL -o "${tmp}/${asset}" "${base}/${asset}"
74:           curl -fsSL -o "${tmp}/checksums.txt" "${base}/gitleaks_${GITLEAKS_VERSION}_checksums.txt"
75:           (cd "$tmp" && grep " ${asset}\$" checksums.txt | sha256sum -c -)
76:           tar -xzf "${tmp}/${asset}" -C "$tmp" gitleaks
77:           install -m 0755 "${tmp}/gitleaks" "$HOME/.local/bin/gitleaks"
78:       - name: Run scripts unit tests
79:         run: python -m unittest discover -s scripts -p 'test_*.py'
80:       - name: Run pre-commit hooks
81:         run: pre-commit run --all-files --show-diff-on-failure
</file>

<file path=".github/workflows/release-drafter.yml">
 1: name: Release Drafter
 2: on:
 3:   push:
 4:     branches:
 5:       - main
 6:   pull_request:
 7:     types: [opened, reopened, synchronize]
 8: concurrency:
 9:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
10:   cancel-in-progress: true
11: permissions:
12:   contents: read
13: jobs:
14:   update_release_draft:
15:     permissions:
