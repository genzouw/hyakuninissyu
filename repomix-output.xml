<file path=".github/workflows/lychee.yml">
 1: name: Lychee Link Checker
 2: on:
 3:   push:
 4:     branches:
 5:       - main
 6:       - master
 7:   pull_request:
 8:     branches:
 9:       - main
10:       - master
11:   schedule:
12:     - cron: '0 0 * * 0' # 毎週日曜日に実行
13:   workflow_dispatch: {}
14: concurrency:
15:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
16:   cancel-in-progress: true
17: permissions:
18:   contents: read
19: jobs:
20:   link-checker:
21:     name: Lychee Link Checker
22:     runs-on: ubuntu-latest
23:     permissions:
24:       contents: read
25:     steps:
26:       - name: Harden Runner
27:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
28:         with:
29:           egress-policy: audit
30:       - name: Checkout repository
31:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
32:         with:
33:           persist-credentials: false
34:       - name: Install lychee
35:         env:
36:           LYCHEE_VERSION: lychee-v0.24.2
37:           LYCHEE_ASSET: lychee-x86_64-unknown-linux-gnu.tar.gz
38:         run: |
39:           set -euo pipefail
40:           workdir="$(mktemp -d)"
41:           curl -sSfLo "${workdir}/${LYCHEE_ASSET}" "https://github.com/lycheeverse/lychee/releases/download/${LYCHEE_VERSION}/${LYCHEE_ASSET}"
42:           curl -sSfLo "${workdir}/${LYCHEE_ASSET}.sha256" "https://github.com/lycheeverse/lychee/releases/download/${LYCHEE_VERSION}/${LYCHEE_ASSET}.sha256"
43:           (cd "${workdir}" && sha256sum -c "${LYCHEE_ASSET}.sha256")
44:           # tarball には README.md や docs/*.md も同梱されており、リポジトリ直下に展開すると
45:           # lychee 自身のドキュメント（存在しない assets/yes.svg 等へのリンクを含む）が
46:           # リンクチェック対象に混入してしまうため、リポジトリ外の一時ディレクトリに展開する。
47:           tar -xzf "${workdir}/${LYCHEE_ASSET}" --strip-components=1 -C "${workdir}"
48:           sudo mv "${workdir}/lychee" /usr/local/bin/lychee
49:           rm -rf "${workdir}"
50:       - name: Run Lychee
51:         env:
52:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
53:         run: |
54:           # www.npmjs.com は GitHub Actions からのアクセスを bot とみなして
55:           # 403 Forbidden を返すことがあるため、実リンク切れではなくチェック対象から除外する。
56:           lychee --verbose --no-progress \
57:             --root-dir './static' \
58:             --exclude-path 'node_modules' \
59:             --exclude-path 'dist' \
60:             --exclude 'https://hyakuninissyu\.genzouw\.com/hyakunin_issyu\.png' \
61:             --exclude 'https://www\.npmjs\.com/' \
62:             './**/*.md' './**/*.html' './**/*.vue'
</file>

