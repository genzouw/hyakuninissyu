257: <script>
258: import _ from 'underscore'
259: import poems from '@/data/poems'
260: import { useSpeech } from '@/composables/useSpeech'
261: export default {
262:   setup () {
263:     const { enableSpeak, toggleSpeak, speakText } = useSpeech()
264:     return { enableSpeak, toggleSpeak, speakText }
265:   },
266:   data () {
267:     return {
268:       // ゲーム設定
269:       gameStarted: false,
270:       gameFinished: false,
271:       selectedQuestionCount: 10,
272:       difficulty: 'normal',
273:       // 問題データ
274:       questions: [],
275:       currentQuestionIndex: 0,
276:       currentQuestion: {},
277:       choices: [],
278:       correctAnswerIndex: -1,
279:       // プレイヤーの状態
280:       playerScore: 0,
281:       playerAnswerTime: null,
282:       // AIの状態
283:       aiScore: 0,
284:       aiAnswerTime: null,
285:       aiWrong: false,
286:       // ラウンド状態（早押し式）
287:       roundFinished: false,
288:       winner: null, // 'player', 'ai', null（どちらも不正解）
289:       winnerAnswerIndex: -1,
290:       transitionMessage: '',
291:       aiTimeout: null,
292:       currentRoundId: 0, // 各問題に一意のIDを割り当てて競合を防ぐ
293:       // カウントダウン
294:       countdown: 0,
295:       countdownInterval: null,
296:       canAnswer: false, // プレイヤーが回答可能かどうか
297:     }
298:   },
299:   computed: {
300:     aiAccuracy () {
301:       const accuracyMap = {
302:         easy: 0.5, // 50% - 弱い
303:         normal: 0.75, // 75% - 普通
304:         hard: 0.95, // 95% - 強い
305:       }
306:       return accuracyMap[this.difficulty] || 0.75
307:     },
308:     aiDelayRange () {
309:       const delayMap = {
310:         easy: { min: 4500, max: 7500 }, // 遅い（4.5〜7.5秒）
311:         normal: { min: 2250, max: 4500 }, // 普通（2.25〜4.5秒）
312:         hard: { min: 750, max: 2250 }, // 速い（0.75〜2.25秒）
313:       }
314:       return delayMap[this.difficulty] || { min: 2250, max: 4500 }
315:     },
316:   },
317:   methods: {
318:     startGame () {
319:       this.gameStarted = true
320:       this.loadQuestions()
321:       this.loadQuestion()
322:     },
323:     loadQuestions () {
324:       // 全100首からランダムに必要な問題数を選択
325:       this.questions = _.sample(poems, this.selectedQuestionCount)
326:     },
327:     loadQuestion () {
328:       if (this.currentQuestionIndex >= this.questions.length) {
329:         this.finishGame()
330:         return
331:       }
332:       this.currentQuestion = this.questions[this.currentQuestionIndex]
333:       // 選択肢を生成（正解 + ダミー3つ）
334:       const dummyAnswers = poems
335:         .filter((q) => q.answer !== this.currentQuestion.answer)
336:         .map((q) => q.answer)
337:       const selectedDummyAnswers = _.sample(dummyAnswers, 3)
338:       const allChoices = [this.currentQuestion.answer, ...selectedDummyAnswers]
339:       this.choices = _.shuffle(allChoices)
340:       // 正解のインデックスを保存
341:       this.correctAnswerIndex = this.choices.indexOf(
342:         this.currentQuestion.answer
343:       )
344:       // 早押し式：状態をリセット
345:       this.roundFinished = false
346:       this.winner = null
347:       this.winnerAnswerIndex = -1
348:       this.transitionMessage = ''
349:       this.playerAnswerTime = null
350:       this.aiAnswerTime = null
351:       this.aiWrong = false
352:       this.canAnswer = false // カウントダウン中は回答不可
353:       // 新しいラウンドIDを生成して、古いAIタイマーのコールバックを無効化
354:       this.currentRoundId++
355:       // AIのタイマーをクリア（前の問題のタイマーが残っている場合）
356:       if (this.aiTimeout) {
357:         clearTimeout(this.aiTimeout)
358:         this.aiTimeout = null
359:       }
360:       // カウントダウンタイマーをクリア（前の問題のタイマーが残っている場合）
361:       if (this.countdownInterval) {
362:         clearInterval(this.countdownInterval)
363:         this.countdownInterval = null
364:       }
365:       // 3秒カウントダウンを開始
366:       this.countdown = 3
367:       this.countdownInterval = setInterval(() => {
368:         this.countdown--
369:         if (this.countdown <= 0) {
370:           clearInterval(this.countdownInterval)
371:           this.countdownInterval = null
372:           // カウントダウン終了後の処理順序：
373:           // 1. 音声読み上げ
374:           // 2. AIタイマー開始（重要：プレイヤーの回答許可より先に開始）
375:           // 3. プレイヤーの回答許可
376:           this.speakQuestionIfEnabled()
377:           // AIタイマーを開始（currentRoundIdをキャプチャ）
378:           this.simulateAIAnswer()
379:           // プレイヤーの回答を許可
380:           // AIタイマーが確実に設定された後に許可することで競合状態を回避
381:           this.$nextTick(() => {
382:             this.canAnswer = true
383:           })
384:         }
385:       }, 1000)
386:     },
387:     selectAnswer (index) {
388:       // 回答不可の場合（カウントダウン中など）は何もしない
389:       if (!this.canAnswer || this.roundFinished) {
390:         return
391:       }
392:       // プレイヤーの回答時刻を記録
393:       this.playerAnswerTime = Date.now()
394:       // 正解かどうか判定
395:       const isCorrect = index === this.correctAnswerIndex
396:       if (isCorrect) {
397:         // プレイヤーが正解 → 即座にラウンド終了
398:         this.roundFinished = true
399:         this.winner = 'player'
400:         this.winnerAnswerIndex = index
401:         this.playerScore++
402:         this.$store.dispatch(
403:           'collection/addCollectedPoem',
404:           this.currentQuestion.id
405:         )
406:         // 正解の下の句を読み上げ
407:         this.speakAnswer()
408:         // AIのタイマーをキャンセル
409:         if (this.aiTimeout) {
410:           clearTimeout(this.aiTimeout)
411:           this.aiTimeout = null
412:         }
413:         // 2秒後に次の問題へ自動遷移
414:         this.transitionMessage = '2秒後に次の問題へ進みます...'
415:         setTimeout(() => {
416:           this.nextQuestion()
417:         }, 2000)
418:       } else {
419:         // プレイヤーが不正解 → AIの結果を待つ
420:         // AIがまだ答えていない場合は何もせず、AIのタイマーが発火するのを待つ
421:         // AIが既に答えている場合は、AIが正解していれば勝ち、そうでなければ引き分け
422:         if (this.aiAnswerTime !== null) {
423:           this.checkResult()
424:         }
425:       }
426:     },
427:     simulateAIAnswer () {
428:       // AIの思考時間（ランダム遅延）
429:       const delay =
430:         this.getSecureRandom() *
431:           (this.aiDelayRange.max - this.aiDelayRange.min) +
432:         this.aiDelayRange.min
433:       // 【競合状態対策】現在のラウンドIDをキャプチャ
434:       // このパターンにより、古いタイマーのコールバックを安全に無効化できる
435:       // 理由: clearTimeoutだけでは既にスケジュールされたコールバックの実行を完全には防げないため
436:       const roundIdAtStart = this.currentRoundId
437:       this.aiTimeout = setTimeout(() => {
438:         // 【競合状態チェック1】ラウンドIDの検証
439:         // ラウンドIDが変わっている = 既に次の問題に移行している
440:         // → この古いタイマーのコールバックをスキップ
441:         if (this.currentRoundId !== roundIdAtStart) {
442:           return
443:         }
444:         // 【競合状態チェック2】ラウンド終了状態の検証
445:         // プレイヤーが先に正解してラウンドが終了している場合はスキップ
446:         if (this.roundFinished) {
447:           return
448:         }
449:         // AIの回答時刻を記録
450:         this.aiAnswerTime = Date.now()
451:         // AIが正解するかどうかを判定
452:         const willAnswerCorrectly = this.getSecureRandom() < this.aiAccuracy
453:         if (willAnswerCorrectly) {
454:           // AIが正解 → 即座にラウンド終了
455:           this.roundFinished = true
456:           this.winner = 'ai'
457:           this.winnerAnswerIndex = this.correctAnswerIndex
458:           this.aiScore++
459:           // 正解の下の句を読み上げ
460:           this.speakAnswer()
461:           // 2秒後に次の問題へ自動遷移
462:           this.transitionMessage = '2秒後に次の問題へ進みます...'
463:           setTimeout(() => {
464:             this.nextQuestion()
465:           }, 2000)
466:         } else {
467:           // AIが不正解 → プレイヤーの結果を確認
468:           // 「お手つき！」バッジを表示してユーザーに視覚的フィードバックを提供
469:           this.aiWrong = true
470:           this.checkResult()
471:         }
472:       }, delay)
473:     },
474:     checkResult () {
475:       // プレイヤーとAIの両方が回答済みで、どちらも正解していない場合は引き分け
476:       if (this.playerAnswerTime !== null && this.aiAnswerTime !== null) {
477:         this.roundFinished = true
478:         this.winner = null
479:         this.winnerAnswerIndex = -1
480:         // 2秒後に次の問題へ自動遷移
481:         this.transitionMessage = '2秒後に次の問題へ進みます...'
482:         setTimeout(() => {
483:           this.nextQuestion()
484:         }, 2000)
485:       }
486:     },
487:     nextQuestion () {
488:       this.currentQuestionIndex++
489:       this.loadQuestion()
490:     },
491:     speakQuestionIfEnabled () {
492:       this.speakText(this.currentQuestion.question)
493:     },
494:     speakAnswer () {
495:       this.speakText(this.currentQuestion.answer)
496:     },
497:     getSecureRandom () {
498:       const cryptoObj = window.crypto || window.msCrypto
499:       if (cryptoObj?.getRandomValues) {
500:         const array = new Uint32Array(1)
501:         cryptoObj.getRandomValues(array)
502:         return array[0] / (0xffffffff + 1)
503:       }
504:       // CSPRNG が利用できない環境向けのフォールバック (古いブラウザやテスト環境での実行時エラーを防ぐ)
505:       return Math.random()
506:     },
507:     clickSpeakToggle () {
508:       this.toggleSpeak()
509:       this.speakQuestionIfEnabled()
510:     },
511:     finishGame () {
512:       this.gameFinished = true
513:       // 結果画面に遷移
514:       this.$router.push({
515:         path: `/ai-battle-result/${this.playerScore}/${this.aiScore}/${this.selectedQuestionCount}/${this.difficulty}`,
516:       })
517:     },
518:   },
519: }
520: </script>
