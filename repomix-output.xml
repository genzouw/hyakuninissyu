155: <script>
156: import _ from 'underscore'
157: import poems from '@/data/poems'
158: import {
159:   getTodaysChallengePoems,
160:   isTodaysChallengeCompleted,
161:   getCurrentStreak,
162:   updateStreak,
163:   markTodaysChallengeCompleted,
164:   getTimeUntilNextChallenge,
165: } from '@/utils/dailyChallenge'
166: import { useSpeech } from '@/composables/useSpeech'
167: export default {
168:   name: 'DailyChallenge',
169:   setup () {
170:     const { enableSpeak, toggleSpeak, speakText } = useSpeech()
171:     return { enableSpeak, toggleSpeak, speakText }
172:   },
173:   data () {
174:     return {
175:       alreadyCompleted: false,
176:       currentQuestionIndex: 0,
177:       score: 0,
178:       newlyCollectedCount: 0,
179:       questionData: {
180:         question: '',
181:         choices: [],
182:         answer: '',
183:       },
184:       choice: null,
185:       thinking: false,
186:       questionList: [],
187:       currentStreak: 0,
188:       countdown: {
189:         hours: 0,
190:         minutes: 0,
191:         seconds: 0,
192:       },
193:       countdownInterval: null,
194:     }
195:   },
196:   mounted () {
197:     // 既にクリア済みかチェック
198:     if (isTodaysChallengeCompleted()) {
199:       this.alreadyCompleted = true
200:       this.currentStreak = getCurrentStreak()
201:       this.startCountdown()
202:     } else {
203:       // 今日のチャレンジ用の5首を取得
204:       const todaysPoems = getTodaysChallengePoems(poems)
205:       this.questionList = todaysPoems.map((poem) => ({
206:         id: poem.id,
207:         question: poem.question,
208:         answer: poem.answer,
209:         choices: [],
210:       }))
211:       // 選択肢を生成
212:       const allAnswers = poems.map((p) => p.answer)
213:       this.questionList.forEach((q) => {
214:         const dummies = _.shuffle(
215:           allAnswers.filter((a) => a !== q.answer)
216:         ).slice(0, 3)
217:         q.choices = _.shuffle([q.answer, ...dummies])
218:       })
219:       this.currentStreak = getCurrentStreak()
220:       this.loadQuestion()
221:     }
222:   },
223:   beforeUnmount () {
224:     if (this.countdownInterval) {
225:       clearInterval(this.countdownInterval)
226:     }
227:   },
228:   methods: {
229:     async clickAnswer () {
230:       this.thinking = false
231:       this.speakText(this.questionData.answer)
232:       // 正解したら
233:       if (this.questionData.answer === this.choice) {
234:         this.score++
235:         const rightSound = this.$refs.rightSoundDaily
236:         rightSound.play()
237:         // コレクション図鑑に追加（新規追加だった場合のみカウント）
238:         const poemId = this.questionData.id
239:         const isNew = await this.addToCollection(poemId)
240:         if (isNew) {
241:           this.newlyCollectedCount++
242:         }
243:       } else {
244:         const wrongSound = this.$refs.wrongSoundDaily
245:         wrongSound.play()
246:       }
247:     },
248:     clickNext () {
249:       this.currentQuestionIndex++
250:       if (this.currentQuestionIndex < 5) {
251:         this.loadQuestion()
252:       } else {
253:         // 全問終了
254:         const isSuccess = this.score === 5
255:         const previousStreak = this.currentStreak
256:         updateStreak(isSuccess)
257:         if (isSuccess) {
258:           markTodaysChallengeCompleted()
259:         }
260:         const newStreak = getCurrentStreak()
261:         this.$router.push({
262:           name: 'DailyChallengeResult',
263:           params: {
264:             score: this.score,
265:             streak: newStreak,
266:             previousStreak,
267:             newlyCollectedCount: this.newlyCollectedCount,
268:           },
269:         })
270:       }
271:     },
272:     loadQuestion () {
273:       this.questionData = this.questionList[this.currentQuestionIndex]
274:       this.choice = null
275:       this.thinking = true
276:       this.speakQuestionIfEnabled()
277:     },
278:     addToCollection (poemId) {
279:       return this.$store.dispatch('collection/addCollectedPoem', poemId)
280:     },
281:     startCountdown () {
282:       this.updateCountdown()
283:       this.countdownInterval = setInterval(() => {
284:         this.updateCountdown()
285:       }, 1000)
286:     },
287:     updateCountdown () {
288:       this.countdown = getTimeUntilNextChallenge()
289:     },
290:     clickSpeakToggle () {
291:       this.toggleSpeak()
292:       this.speakQuestionIfEnabled()
293:     },
294:     speakQuestionIfEnabled () {
295:       this.speakText(this.questionData.question)
296:     },
297:   },
298: }
299: </script>
