<file path=".github/workflows/deploy.yml">
  1: name: Deploy to S3 and Invalidate CloudFront
  2: on:
  3:   push:
  4:     branches:
  5:       - main
  6: concurrency:
  7:   group: ${{ github.workflow }}-${{ github.ref }}
  8:   cancel-in-progress: false
  9: permissions:
 10:   contents: read
 11: env:
 12:   AWS_REGION: ap-northeast-1
 13:   S3_BUCKET: genzouw-static-content
 14:   S3_PREFIX: hyakunin
 15:   CLOUDFRONT_DISTRIBUTION_ID: E6OM0XCJX1HGU
 16: jobs:
 17:   build:
 18:     permissions:
 19:       contents: read
 20:     runs-on: ubuntu-latest
 21:     steps:
 22:       - name: Harden Runner
 23:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
 24:         with:
 25:           egress-policy: audit
 26:       - name: Checkout
 27:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
 28:         with:
 29:           persist-credentials: false
 30:       - name: Setup Bun Environment
 31:         uses: ./.github/actions/setup-bun-env
 32:       - name: Build
 33:         env:
 34:           GA_ID: ${{ vars.GA_ID }}
 35:           NODE_OPTIONS: --openssl-legacy-provider
 36:         run: bun run build
 37:       - name: Upload artifact
 38:         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
 39:         with:
 40:           name: dist
 41:           path: dist/
 42:           if-no-files-found: error
 43:   deploy:
 44:     needs: build
 45:     permissions:
 46:       id-token: write
 47:       contents: read
 48:     runs-on: ubuntu-latest
 49:     # 本リポジトリは公開されているため、本番デプロイは GitHub Environment 経由に
 50:     # 限定している。この宣言があると OIDC トークンの subject が
 51:     #
 52:     #   repo:genzouw/hyakuninissyu:environment:production
 53:     #
 54:     # となり、AWS 側の信頼ポリシーがこの形だけを許可している。environment を
 55:     # 宣言しないワークフローや、main 以外のブランチからのワークフローは
 56:     # デプロイ用ロールを引き受けられない (production 環境のデプロイ可能ブランチを
 57:     # main に限定しているため)。
 58:     #
 59:     # fork からの PR では OIDC トークンが発行されず secrets も渡らないので、
 60:     # 外部からの PR がこの経路でデプロイすることは元からできない。
 61:     environment: production
 62:     steps:
 63:       - name: Harden Runner
 64:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
 65:         with:
 66:           egress-policy: audit
 67:       - name: Download artifact
 68:         uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
 69:         with:
 70:           name: dist
 71:           path: dist/
 72:       - name: Configure AWS credentials
 73:         uses: aws-actions/configure-aws-credentials@cbe3b392738ccf3f987d68400dafcf4b0624a56c # v6.2.4
 74:         with:
 75:           role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
 76:           aws-region: ${{ env.AWS_REGION }}
 77:       # IndexNow のキーファイルをデプロイ時に動的生成する。
 78:       # 公開リポジトリでキーファイルを直接コミットすると場所が露見するため、Secrets から生成する。
 79:       - name: Generate IndexNow key file
 80:         env:
 81:           INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
 82:         run: |
 83:           if [ -z "${INDEXNOW_KEY}" ]; then
 84:             echo "INDEXNOW_KEY secret is not set" >&2
 85:             exit 1
 86:           fi
 87:           printf '%s' "${INDEXNOW_KEY}" > "dist/${INDEXNOW_KEY}.txt"
 88:       - name: Deploy to S3
 89:         run: |
 90:           aws s3 sync dist/ "s3://${S3_BUCKET}/${S3_PREFIX}/" \
 91:             --delete \
 92:             --cache-control "max-age=31536000,public" \
 93:             --exclude "*.html" \
 94:             --exclude "*.json" \
 95:             --exclude "*.txt" \
 96:             --exclude "*.xml"
 97:           # HTML, JSON, TXT (llms.txt, etc.), XML (sitemap.xml) files with shorter cache
 98:           aws s3 sync dist/ "s3://${S3_BUCKET}/${S3_PREFIX}/" \
 99:             --delete \
100:             --cache-control "max-age=0,no-cache,no-store,must-revalidate" \
101:             --exclude "*" \
102:             --include "*.html" \
103:             --include "*.json" \
104:             --include "*.txt" \
105:             --include "*.xml"
106:       - name: Invalidate CloudFront cache
107:         run: |
108:           aws cloudfront create-invalidation \
109:             --distribution-id "${CLOUDFRONT_DISTRIBUTION_ID}" \
110:             --paths "/${S3_PREFIX}/*"
111:   indexnow:
112:     needs: deploy
113:     permissions: {}
114:     runs-on: ubuntu-latest
115:     env:
116:       SITEMAP_URL: 'https://hyakuninissyu.genzouw.com/sitemap.xml'
117:       INDEXNOW_HOST: 'hyakuninissyu.genzouw.com'
118:       INDEXNOW_KEY: ${{ secrets.INDEXNOW_KEY }}
119:     steps:
120:       # bojieyang/indexnow-action はリポジトリの Actions allow list 外のため、
121:       # IndexNow API への直接呼び出しに置換している。
122:       - name: Harden Runner
123:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
124:         with:
125:           egress-policy: audit
126:       - name: Submit URLs to IndexNow API
127:         run: |
128:           set -euo pipefail
129:           if [ -z "${INDEXNOW_KEY}" ]; then
130:             echo "INDEXNOW_KEY secret is not set" >&2
131:             exit 1
132:           fi
133:           # sitemap.xml を取得し <loc> 要素から URL リストを抽出
134:           curl --fail --silent --show-error --location \
135:             --retry 3 --retry-delay 5 --max-time 30 \
136:             "${SITEMAP_URL}" -o /tmp/sitemap.xml
137:           grep -oE '<loc>[^<]+</loc>' /tmp/sitemap.xml \
138:             | sed -E 's|<loc>([^<]+)</loc>|\1|' > /tmp/urls.txt
139:           if [ ! -s /tmp/urls.txt ]; then
140:             echo "No URLs found in sitemap: ${SITEMAP_URL}" >&2
141:             exit 1
142:           fi
143:           # IndexNow API へ JSON ペイロードで送信 (1 リクエストあたり最大 10000 URL)
144:           jq -Rn \
145:             --arg host "${INDEXNOW_HOST}" \
146:             --arg key "${INDEXNOW_KEY}" \
147:             --arg keyLocation "https://${INDEXNOW_HOST}/${INDEXNOW_KEY}.txt" \
148:             --rawfile urls /tmp/urls.txt \
149:             '{
150:                host: $host,
151:                key: $key,
152:                keyLocation: $keyLocation,
153:                urlList: ($urls | split("\n") | map(select(length > 0)))
154:              }' > /tmp/payload.json
155:           curl --fail --silent --show-error \
156:             --retry 3 --retry-delay 5 --max-time 30 \
157:             -X POST 'https://api.indexnow.org/IndexNow' \
158:             -H 'Content-Type: application/json; charset=utf-8' \
159:             --data-binary @/tmp/payload.json
</file>

<file path=".github/workflows/forbid-pr-target.yml">
 1: name: Forbid risky PR trigger
 2: on:
 3:   push:
 4:     branches: [main, master]
 5:   pull_request:
 6:     branches: ['**']
 7:   schedule:
 8:     - cron: '0 21 * * 0' # 毎週月曜 06:00 JST (= 日曜 21:00 UTC)
 9:   workflow_dispatch:
10: concurrency:
11:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
12:   cancel-in-progress: true
13: permissions:
14:   contents: read
15: jobs:
16:   check-pr-target:
17:     name: Check for risky PR trigger usage
18:     runs-on: ubuntu-latest
19:     permissions:
20:       contents: read
21:     steps:
22:       - name: Harden Runner
23:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
24:         with:
25:           egress-policy: audit
26:       - name: Checkout repository
27:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
28:         with:
29:           persist-credentials: false
30:       - name: Forbid risky PR trigger
31:         run: |
32:           set -e
33:           # フォークPRからのシークレット漏洩リスクがあるトリガー（pull_request の target 版）を検索する。
34:           # 検索語は実行時にのみ文字列連結で組み立てる。このファイル自身に検索語を連続した綴りで
35:           # 書くと、既存の pre-commit ローカルフック（forbid-pull-request-target, pygrep）に
36:           # ヒットして pre-commit が恒久的に失敗するため。
37:           NEEDLE='pull_request'"_target"
38:           # 単語境界一致（-w）にすることで、マッピング形式（key:）・scalar 形式（on: X）・
39:           # flow 形式（on: [X, push]）のいずれの書き方でも検知する（コロンの有無に依存しない）。
40:           # --include で .yml / .yaml の両拡張子を対象にする（既存の pre-commit フック
41:           # forbid-pull-request-target の files: '^\.github/workflows/.*\.ya?ml$' と範囲を揃える）。
42:           set +e
43:           grep -rwiE --include='*.yml' --include='*.yaml' -- "${NEEDLE}" .github/workflows
44:           status=$?
45:           set -e
46:           if [ "${status}" -eq 0 ]; then
47:             echo "::error::フォークPRからのシークレット漏洩を防ぐため、該当トリガーの使用は禁止されています。pull_request を使用してください。"
48:             exit 1
49:           elif [ "${status}" -eq 1 ]; then
50:             echo "No risky trigger found. Good!"
51:           else
52:             echo "::error::grep の実行に失敗しました（終了コード: ${status}）。検査を完了できないため失敗として扱います。"
53:             exit "${status}"
54:           fi
</file>

<file path=".github/workflows/gitleaks.yml">
 1: name: Gitleaks
 2: # 本ワークフローは genzouw/ci-workflows の reusable workflow を呼び出す薄いスタブ。
 3: # ロジックの実体・変更は ci-workflows 側で一元管理する (トリガー定義のみここで持つ)。
 4: # 参照 SHA の更新は Dependabot (github-actions ecosystem) が自動で PR を出す。
 5: # 必須チェック (context: "gitleaks / Scan for leaked secrets") のため paths フィルタ禁止。
 6: on:
 7:   # push は既定ブランチのみ。'**' にすると、オープンなPRがあるブランチへの push で
 8:   # push と pull_request が同時発火し、同一コミットに対して二重実行される（#447）。
 9:   # PR の検証は pull_request 側が担う。
10:   push:
11:     branches: [main, master]
12:   pull_request:
13:     branches: ['**']
14:   schedule:
15:     # 毎週月曜 05:00 JST (= 日曜 20:00 UTC) に履歴全体を再スキャン
16:     - cron: '0 20 * * 0'
17:   workflow_dispatch:
18: concurrency:
19:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
20:   cancel-in-progress: true
21: permissions:
22:   contents: read
23: jobs:
24:   gitleaks:
25:     permissions:
26:       contents: read
27:       security-events: write
28:     uses: genzouw/ci-workflows/.github/workflows/gitleaks.yml@28d2b9b6f563eb1126e786f28e308390b2558a47 # v1.0.1
</file>

