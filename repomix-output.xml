<file path=".markuplintrc">
 1: {
 2:   "parser": {
 3:     ".vue$": "@markuplint/vue-parser"
 4:   },
 5:   "extends": [
 6:     "markuplint:recommended"
 7:   ],
 8:   "rules": {
 9:     // @markuplint/vue-parser（v4.18系）は `:key`（`v-bind:key`）と `ref` を
10:     // ディレクティブではなく素の HTML 属性 `key` / `ref` として解決するため、
11:     // 標準 HTML には存在しない属性として誤検知される。
12:     // Vue SFC ではあらゆる要素に付与しうるため、この2属性のみ全体で許可する。
13:     // パーサー側の制限に対する暫定処置であり、解消されたら削除すること。
14:     "invalid-attr": {
15:       "options": {
16:         "allowAttrs": ["key", "ref"]
17:       }
18:     }
19:   },
20:   "nodeRules": [
21:     {
22:       // @markuplint/vue-parser（v4.18系）は `@keyup.enter` と `@keyup.space` の
23:       // ような「同じイベント種別 + 異なるキー修飾子」を持つ v-on 属性を、
24:       // 修飾子を無視した `onkeyup` という同一の potentialName に解決してしまい、
25:       // attr-duplication が誤検知する（`@keydown.space.prevent` のように
26:       // 修飾子が2つ以上あると正規表現がマッチせず誤検知しない、という
27:       // アンバランスなパーサー側の既知の制限に起因する）。
28:       // .poem-card は Collection.vue のカード要素にのみ使用するクラスのため、
29:       // 影響範囲をこの要素に限定して誤検知のみを抑止する。
30:       "selector": ".poem-card",
31:       "rules": {
32:         "attr-duplication": false
33:       }
34:     },
35:     {
36:       // 正解／不正解の効果音のみを再生する <audio> で、発話情報を含まないため
37:       // キャプション（<track>）は不要。同じ理由で ESLint の
38:       // vuejs-accessibility/media-has-caption も個別に無効化している。
39:       "selector": "audio",
40:       "rules": {
41:         "required-element": false
42:       }
43:     }
44:   ]
45: }
</file>

