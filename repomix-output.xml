<file path=".github/workflows/osv-scanner.yml">
 1: name: OSV-Scanner
 2: on:
 3:   pull_request:
 4:     branches: ['**']
 5:   # push は既定ブランチのみ。'**' にすると、オープンなPRがあるブランチへの push で
 6:   # push と pull_request が同時発火し、同一コミットに対して二重実行される（#447）。
 7:   # PR の検証は pull_request 側が担う。
 8:   push:
 9:     branches: [main, master]
10:   schedule:
11:     - cron: '15 21 * * 0' # 毎週月曜 06:00 JST (= 日曜 21:00 UTC)
12: permissions:
13:   contents: read
14: # 同一ブランチ / PR で OSV-Scanner が重複起動するのを抑止し、無駄な実行を削減
15: concurrency:
16:   group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
17:   cancel-in-progress: true
18: jobs:
19:   osv-scanner:
20:     name: OSV-Scanner
21:     runs-on: ubuntu-latest
22:     permissions:
23:       security-events: write
24:       contents: read
25:     steps:
26:       - name: Harden Runner
27:         uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
28:         with:
29:           egress-policy: audit
30:       - name: Checkout repository
31:         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
32:         with:
33:           # ランナーに認証情報を残さないようにし、credential 漏えい面を縮小
34:           persist-credentials: false
35:       - name: Run OSV-Scanner
36:         uses: google/osv-scanner-action/osv-scanner-action@6e4298ebc4db23e847df9b2e2de2939d6f066c67 # v2.5.1
37:         with:
38:           # 明示的な依存関係に対する脆弱性のみを報告します
39:           # プロジェクトのニーズに合わせて調整可能です
40:           results-file-name: osv-scanner-results.sarif
